---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Fleur from '../components/Fleur.astro';
import { u } from '../lib/site';
---
<Base title="Page introuvable · Christine CAL" description="Cette page n'existe pas ou plus." path="/404/">
  <section class="page-hero sky" style="min-height: 80vh; display: grid; align-items: center">
    <Fleur class="fleur" stroke="rgba(233,204,138,.12)" width={0.4} />
    <div class="wrap center">
      <p class="eyebrow">Page introuvable</p>
      <h1>Cette page a changé de dimension</h1>
      <p class="lede-serif" style="margin-inline: auto">Elle n'existe pas, ou plus. Reprenons le voyage depuis l'accueil.</p>
      <div class="actions" style="justify-content: center; margin-top: 36px">
        <a class="btn btn-gold" href={u('/')}>Accueil</a>
        <a class="btn" href={u('/agenda/')}>Agenda</a>
      </div>
    </div>
  </section>
  <Footer />
</Base>
