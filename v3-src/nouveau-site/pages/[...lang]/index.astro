---
import { langPaths, tr } from '../../lib/i18n';
export const getStaticPaths = langPaths;
/**
 * Accueil : le portail, comme sur le site actuel (souhait de Christine) — la
 * Terre, son nom, ses deux portes. Un seul écran, le menu donne accès à tout.
 */
import Base from '../../layouts/Base.astro';
import { HUBS, u } from '../../lib/site';

const portes = [
  { hub: 'eveil-a-soi' as const, sub: tr('École 5D') },
  { hub: 'eveil-au-soi' as const, sub: tr('Galactique') },
];
---
<Base title={`Christine CAL · ${tr('Éveil à sa multidimensionnalité')}`} description={tr("Christine CAL, coach d'Éveil à la Multidimensionnalité de l'Être. Éveil à Soi (coaching, consultations, stages) et Éveil au Soi (Mont Shasta, TELOS, Nouvelle Terre).")} path="/">
  <section class="portal" aria-label={tr('Portail')}>
    <img class="bg" src={u('/images/wp/portail-terre.png')} alt={tr("La Terre vue de l'espace, un point de lumière se lève sur l'horizon")} fetchpriority="high" />
    <div class="veil"></div>
    <div class="glow-point" aria-hidden="true"></div>
    <div class="portal-top">
      <div class="emblem-cc" aria-hidden="true"><span>CC</span></div>
      <p class="eyebrow">{tr('Éveil à sa multidimensionnalité')}</p>
      <h1>Christine CAL</h1>
      <p class="baseline">{tr('Une galactique venue du futur…')}</p>
    </div>
    <div class="doors">
      {portes.map((p) => (
        <a class="door-oval" href={u(HUBS[p.hub].path)}>
          <b>{HUBS[p.hub].label}</b><small>{p.sub}</small>
        </a>
      ))}
    </div>
    <nav class="portal-legal" aria-label={tr('Informations légales')}>
      <span>© {new Date().getFullYear()} Christine CAL</span>
      <a href={u('/mentions-legales/')}>{tr('Mentions légales')}</a>
      <a href={u('/politique-de-confidentialite/')}>{tr('Confidentialité')}</a>
      <a href={u('/cookies/')}>{tr('Cookies')}</a>
      <span>{tr('Site réalisé par')} <a href="https://studio-margerit.fr" target="_blank" rel="noopener">Studio Margerit</a></span>
    </nav>
  </section>
</Base>
