---
/** Qui suis-je : tout vient du formulaire « Page : Qui suis-je » du CMS (src/data/about.fr.json). */
import Base from '../layouts/Base.astro';
import ContactBand from '../components/ContactBand.astro';
import Hublot from '../components/Hublot.astro';
import Fleur from '../components/Fleur.astro';
import Lemniscate from '../components/Lemniscate.astro';
import VideoCard from '../components/VideoCard.astro';
import { clauses } from '../lib/content';
import { splitDated, u } from '../lib/site';
import about from '../../src/data/about.fr.json';
import auSoi from '../../src/data/eveil-au-soi.fr.json';

/** « UN PARCOURS EN BREF » → « Un parcours en bref » (les titres en capitales restent lisibles en serif). */
const sentence = (s: string) =>
  s === s.toUpperCase() ? s.charAt(0) + s.slice(1).toLowerCase() : s;

const journey = about.journey.items;
const steps = journey.slice(0, -2);
const [left, right] = journey.slice(-2);

/** « … depuis 2003. » → date « Depuis 2003 » (si pas de tiret « 2019 — … »). */
const dated = (item: string) => {
  const d = splitDated(item);
  if (d.date) return d;
  const m = item.match(/^(.*?)\s+depuis\s+(\d{4})\s*\.?$/i);
  return m ? { date: `Depuis ${m[2]}`, text: m[1] + '.' } : d;
};

const [first, ...otherSpecifics] = about.specifics.items;
const trained = first?.match(/^(.*?)\s*[—–-]\s*Formation de plus de\s*([\d\s ]+)\s*personnes\s*(.*?)\.?$/);
const specifics = trained ? otherSpecifics : about.specifics.items;
const rigueur = auSoi.outro?.[0];
---
<Base title={about.meta.title.replace(' — ', ' · ')} description={about.meta.description} path="/qui-suis-je/" image="/images/christine-portrait.jpg">
  <section class="page-hero" aria-labelledby="titre">
    <img class="bg" src={u('/images/wp/galaxie-terre.jpg')} alt="" style="object-position: 60% 50%" />
    <div class="veil" style="background: linear-gradient(90deg, rgba(7,6,24,.9) 0%, rgba(7,6,24,.55) 40%, rgba(7,6,24,.05) 65%), linear-gradient(180deg, rgba(7,6,24,.7) 0%, rgba(7,6,24,0) 22%, rgba(7,6,24,0) 72%, var(--night) 100%)"></div>
    <div class="wrap split">
      <div class="txt">
        <p class="eyebrow">{about.hero.eyebrow}</p>
        <h1 id="titre">{about.hero.title}</h1>
        <p class="label" style="margin-top: 32px">Coach médiumnique · Conférencière</p>
      </div>
      <Hublot src="/images/christine-portrait.jpg" alt="Portrait de Christine CAL, souriante" portrait eager />
    </div>
  </section>

  <section class="section sky epi-section">
    <Fleur class="fleur" />
    <div class="wrap">
      <p class="epigraph">{clauses(about.epigraph).map((c, i) => <><span class:list={['w', { hl: /relier/i.test(c) }]} style={`--d:${(0.2 + i * 0.3).toFixed(1)}s`}>{c}</span>{' '}</>)}</p>
    </div>
  </section>

  <section class="section sky">
    <div class="wrap">
      <h2 class="h2 center">{about.galactic.heading}</h2>
      <svg class="arc" viewBox="0 0 1200 130" aria-hidden="true"><path d="M0 120Q600-40 1200 120" fill="none" stroke="rgba(233,204,138,.4)" stroke-width="1" /><g fill="rgba(233,204,138,.22)"><circle cx="200" cy="71" r="16" /><circle cx="600" cy="40" r="19" /><circle cx="1000" cy="71" r="16" /></g><g fill="#FFF1C9"><circle cx="200" cy="71" r="5" /><circle cx="600" cy="40" r="6" /><circle cx="1000" cy="71" r="5" /></g></svg>
      <div class="triad">{about.galactic.items.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="section sky">
    <div class="wrap">
      <h2 class="h2 center">{sentence(about.journey.heading)}</h2>
      <div class="timeline">
        {steps.map((s, i) => (
          <div class="step">
            {i % 2 === 0 ? (
              <><div class="left"><p class="lead">{s.lead}</p><p class="t" set:html={s.text} /></div><div class="dot"><span></span></div><div class="empty"></div></>
            ) : (
              <><div class="empty"></div><div class="dot"><span></span></div><div><p class="lead">{s.lead}</p><p class="t" set:html={s.text} /></div></>
            )}
          </div>
        ))}
      </div>
      {left && right && (
        <div class="hemis" style="margin-top: 40px">
          <div class="l"><p class="label">{left.lead}</p><p class="big" set:html={left.text} /></div>
          <div class="mid"><Lemniscate /></div>
          <div><p class="label">{right.lead}</p><p class="big" set:html={right.text} /></div>
        </div>
      )}
    </div>
  </section>

  <section class="section deep">
    <div class="wrap">
      <h2 class="h2">{sentence(about.activities.heading)}</h2>
      <div class="two-cols" style="margin-top: 52px">
        <div class="items">
          {about.activities.items.filter((a) => !a.accordion).map((a) => <div><p class="n">{a.title}</p><p class="t" set:html={a.text} /></div>)}
        </div>
        <div class="items">
          {about.activities.items.filter((a) => a.accordion).map((a) => (
            <div>
              <p class="n">{a.title}</p>
              <p class="t" set:html={a.text} />
              <ul class="pills">{a.accordion!.items.slice(0, 8).map((c) => <li>{c}</li>)}</ul>
              {a.accordion!.items.length > 8 && (
                <details class="more">
                  <summary>Toutes les conférences</summary>
                  <ul class="pills">{a.accordion!.items.slice(8).map((c) => <li>{c}</li>)}</ul>
                </details>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section sky">
    <div class="wrap">
      <p class="eyebrow">{sentence(about.specifics.heading)}</p>
      <div class="two-cols" style="margin-top: 36px; align-items: center">
        {trained ? (
          <div class="stack">
            <p class="label" style="color: var(--mist)">Plus de</p>
            <p class="big-num">{trained[2].trim()}</p>
            <p style="margin-top: 14px; font-size: 18px; color: var(--soft)">personnes formées {trained[3]}</p>
            <p class="serif" style="margin-top: 14px; font-size: 26px; line-height: 1.3" set:html={trained[1]} />
          </div>
        ) : <div></div>}
        <ul class="dated">
          {specifics.map((s) => { const d = dated(s); return <li>{d.date && <span class="date">{d.date}</span>}<span set:html={d.text} /></li>; })}
        </ul>
      </div>
    </div>
  </section>

  <section class="section deep">
    <div class="wrap two-cols">
      <div>
        <p class="eyebrow">{sentence(about.news.heading)}</p>
        <div class="items" style="margin-top: 28px">
          {about.news.items.map((n) => { const d = splitDated(n); return <div>{d.date && <p class="date">{d.date}</p>}<p class="t" set:html={d.text} /></div>; })}
        </div>
      </div>
      <div>
        <p class="eyebrow">{sentence(about.upcoming.heading)}</p>
        <div class="items" style="margin-top: 28px">
          {about.upcoming.items.map((n) => {
            const m = n.match(/^([^:]{2,20})\s*:\s*(.+)$/);
            return <div>{m && <p class="date">{m[1]}</p>}<p class="t" set:html={m ? m[2] : n} /></div>;
          })}
        </div>
      </div>
    </div>
  </section>

  {about.videos.list.length > 0 && (
    <section class="section sky">
      <div class="wrap">
        <p class="eyebrow">Informations · Presse</p>
        <h2 class="h2" style="margin-top: 14px">{about.videos.heading}</h2>
        <div class="video-grid">{about.videos.list.map((v) => <VideoCard {...v} />)}</div>
      </div>
    </section>
  )}

  <section class="section deep">
    <div class="wrap two-cols" style="align-items: start">
      <div>
        <p class="eyebrow">{about.clients.heading}</p>
        <p class="serif italic" style="margin-top: 22px; font-size: 25px; line-height: 1.55; color: var(--soft)">{about.clients.text}</p>
      </div>
      {rigueur && (
        <figure class="rigueur">
          <blockquote>« {rigueur} »</blockquote>
        </figure>
      )}
    </div>
  </section>

  <ContactBand />
</Base>
