---
/** L'emblème : deux arcs qui se font face (et un point de lumière au centre). */
interface Props { width?: number; dot?: boolean; class?: string }
const { width = 3.2, dot = false, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 120 120" aria-hidden="true">
  <path d="M50.1 9A52 52 0 0 0 50.1 111" fill="none" stroke="url(#g-arc)" stroke-width={width} stroke-linecap="round" />
  <path d="M69.9 9A52 52 0 0 1 69.9 111" fill="none" stroke="url(#g-arc)" stroke-width={width} stroke-linecap="round" />
  {dot && <circle cx="60" cy="60" r="10" fill="#FFF3D6" />}
</svg>
