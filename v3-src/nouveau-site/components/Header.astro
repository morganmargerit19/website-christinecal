---
import { NAV, u } from '../lib/site';
import Arcs from './Arcs.astro';
import Icon from './Icon.astro';
interface Props { current?: string }
const { current } = Astro.props;
const isCurrent = (path: string) =>
  current === path || (path !== '/' && current?.startsWith(path)) ? 'page' : undefined;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={u('/')} aria-label="Christine CAL, accueil"><Arcs width={7} dot /><span>Christine CAL</span></a>
    <nav class="main-nav" aria-label="Navigation principale">
      {NAV.map((n) => <a href={u(n.path)} aria-current={isCurrent(n.path)}>{n.label}</a>)}
    </nav>
    <span class="lang" title="Version française. Les versions anglaise, espagnole, italienne et polonaise suivront.">FR</span>
    <button class="burger" type="button" data-burger aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu"><Icon name="menu" /></button>
  </div>
  <nav id="menu" class="mobile-nav" aria-label="Menu" hidden>
    {NAV.map((n) => <a href={u(n.path)} aria-current={isCurrent(n.path)}>{n.label}</a>)}
  </nav>
</header>
