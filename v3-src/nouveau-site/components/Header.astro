---
import { ANNONCE, NAV, u } from '../lib/site';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { autoData, tr } from '../lib/i18n';
interface Props { current?: string }
const { current } = Astro.props;
// Une seule entrée active : la plus précise (la consultation n'allume pas aussi « Éveil à Soi »).
const active = NAV.filter((n) => current && [n.path, ...(n.also ?? [])].some((p) => current.startsWith(p)))
  .sort((a, b) => b.path.length - a.path.length)[0];
const isCurrent = (path: string) => (active?.path === path ? 'page' : undefined);
// Annonce écrite par Christine en français, traduite automatiquement (scripts/traduire.mjs).
const texte = autoData<{ annonce?: string }>('infos')?.annonce ?? ANNONCE?.texte;
---
<header class="site-header">
  {ANNONCE && (
    <p class="annonce">
      {ANNONCE.lien ? <a href={/^\//.test(ANNONCE.lien) ? u(ANNONCE.lien) : ANNONCE.lien}>{texte}</a> : texte}
    </p>
  )}
  <div class="wrap bar">
    <a class="brand" href={u('/')} aria-label={tr('Christine CAL, accueil')}>Christine CAL</a>
    <nav class="main-nav" aria-label={tr('Navigation principale')}>
      {NAV.map((n) => <a href={u(n.path)} aria-current={isCurrent(n.path)}>{tr(n.label)}</a>)}
    </nav>
    <div class="bar-end">
      <LangSwitch />
      <button class="burger" type="button" data-burger aria-controls="menu" aria-expanded="false" aria-label={tr('Ouvrir le menu')} data-open={tr('Ouvrir le menu')} data-close={tr('Fermer le menu')}><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="menu" class="mobile-nav" aria-label={tr('Menu')} hidden>
    <a href={u('/')} aria-current={current === '/' ? 'page' : undefined}>{tr('Accueil')}</a>
    {NAV.map((n) => <a href={u(n.path)} aria-current={isCurrent(n.path)}>{tr(n.label)}</a>)}
  </nav>
</header>
