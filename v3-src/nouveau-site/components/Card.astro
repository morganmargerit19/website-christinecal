---
/** Carte d'un stage / d'une rubrique : photo (ou fleur de vie), date, titre, résumé. */
import type { CollectionEntry } from 'astro:content';
import { slugOf } from '../../src/lib/fiches';
import { OLD_NEW, fichePath, type Hub, u } from '../lib/site';
import { framedVisualOf, isStrip } from '../lib/images';
import Geo from './Geo.astro';
import GeoFleur from './GeoFleur.astro';
import GeoMerkaba from './GeoMerkaba.astro';
import Lumiere from './Lumiere.astro';
import { ACTIVATION, ECOLE_GEO } from '../lib/ecole';
import { tr, trn } from '../lib/i18n';
interface Props { entry: CollectionEntry<'fiches'>; count?: number; feature?: boolean }
const { entry, count, feature = false } = Astro.props;
const f = entry.data;
const geo = ECOLE_GEO[slugOf(entry.id)];
// Sortir de sa matrice : la carte montre « Old Life / New Life », pas la roue (retours du 22/10).
const matrice = f.richLayout === 'sortir-matrice';
const framed = geo || matrice ? {} : framedVisualOf(f);
const img = geo ? undefined : matrice ? OLD_NEW : framed.src;
/**
 * Cartes avec un visuel fait sur mesure. Team galactique : une galaxie (générée par
 * Morgan) avec les lettres « Les Frères des Etoiles » détourées du bandeau d'origine,
 * même écriture (retours du 27/10).
 */
const COVERS: Record<string, { src: string; alt: string }> = {
  'la-team-galactique': { src: '/images/wp/freres-des-etoiles-carte.jpg', alt: tr('Les Frères des Étoiles') },
};
const cover = COVERS[slugOf(entry.id)];
// Faute de photo, un bandeau-titre plutôt que la fleur de vie.
const band = !geo && !img && !cover && f.image && isStrip(f.image) ? f.image : undefined;
// Les dates ne s'affichent que sur la page Agenda (demande de Christine, 10/11).
const label = count ? trn('{n} stage', '{n} stages', count) : f.kicker;
const meta = !count ? [f.place, f.format, f.duration, f.price].filter(Boolean).join(' · ') : '';
---
<a class:list={['card', { 'card--feature': feature }]} href={fichePath(f.hub as Hub, slugOf(entry.id))}>
  <span class:list={['img', { 'img--geo': geo && geo !== 'lumiere', 'img--lumiere': geo === 'lumiere', 'img--band': band, 'img--cover': cover }]}>{cover ? <img src={u(cover.src)} alt={cover.alt} loading="lazy" />
    : img ? <img src={u(img)} alt={matrice ? tr("D'une ancienne vie à une nouvelle vie") : f.imageAlt || ''} loading="lazy" style={framed.pos ? `object-position:${framed.pos}` : undefined} />
    : band ? <><img class="band-fill" src={u(band)} alt="" aria-hidden="true" loading="lazy" /><img class="band-title" src={u(band)} alt={f.imageAlt || ''} loading="lazy" /></>
    : geo === 'merkaba' ? <GeoMerkaba /> : geo === 'activation' ? <img class="activation" src={u(ACTIVATION)} alt="" loading="lazy" /> : geo === 'fleur' ? <GeoFleur /> : geo === 'lumiere' ? <Lumiere variant="card" alt={f.imageAlt || ''} /> : <Geo />}</span>
  <span>
    <span class="label">{label}</span>
    <span class="t">{f.title}</span>
    <span class="d">{f.cardLede || f.lede}</span>
    {meta && <span class="m">{meta}</span>}
  </span>
</a>
