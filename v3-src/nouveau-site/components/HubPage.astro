---
/**
 * Page d'un univers (Éveil à Soi / Éveil au Soi). Textes : formulaire
 * « Page : Éveil à Soi / au Soi » du CMS. Cartes et dates : les fiches.
 */
import Base from '../layouts/Base.astro';
import ContactBand from './ContactBand.astro';
import Card from './Card.astro';
import VideoCard from './VideoCard.astro';
import AgendaList from './AgendaList.astro';
import Icon from './Icon.astro';
import Fleur from './Fleur.astro';
import { getFiches, slugOf, stagesOf } from '../../src/lib/fiches';
import { ECOLE } from '../lib/ecole';
import { buildAgenda } from '../lib/agenda';
import { topLevel } from '../lib/content';
import { HUBS, SHASTA, u, type Hub } from '../lib/site';
import { exists } from '../lib/images';
import aSoi from '../../src/data/eveil-a-soi.fr.json';
import auSoi from '../../src/data/eveil-au-soi.fr.json';

interface Props { hub: Hub }
const { hub } = Astro.props;
const data = hub === 'eveil-a-soi' ? aSoi : auSoi;
const outro = 'outro' in data ? (data.outro as string[]) : [];
const fiches = await getFiches('fr');
// L'École 5D et le Mont Shasta ont leur propre onglet : pas de carte en double (retours du 22/10).
const OWN_TAB = [ECOLE, SHASTA];
const cards = topLevel(fiches, hub).filter((c) => !OWN_TAB.includes(slugOf(c.id)));
// Éveil à Soi : Consultation et Sortir de sa matrice côte à côte, comme sur le site actuel.
const duo = hub === 'eveil-a-soi' && cards.length === 2;
const feature = (i: number) => !duo && i === 0 && cards[0].data.featured;
const regular = cards.filter((c, i) => !feature(i)).length;
const { entries } = buildAgenda(fiches.filter((f) => f.data.hub === hub));
// Éveil au Soi : disposition de la page du site actuel (retours de Christine) —
// titre, bandeau, introduction complète, cartes, phrases de clôture.
const classic = hub === 'eveil-au-soi';
// Éveil à Soi : la spirale qui se déploie du site actuel (retours du 22/10) et, derrière,
// une photo d'une personne dans la lumière bleue, en fond comme l'École 5D (retours du 27/10).
// Tant que le fichier n'est pas déposé dans public/, l'en-tête reste sur fond nuit.
const ASOI_BG = '/images/wp/eveil-a-soi-fond.jpg';
const heroBg = hub === 'eveil-a-soi' && exists(ASOI_BG) ? { src: ASOI_BG, pos: '60% 40%' } : undefined;
const share = hub === 'eveil-a-soi' ? (heroBg?.src ?? '/images/geometrie/spirale-fibonacci.svg') : '/images/wp/shasta2.jpg';

/**
 * Introduction regroupée : la phrase d'accroche seule, puis les phrases qui se
 * répondent dans un même paragraphe (Éveil à Soi : 7 lignes → 4 paragraphes).
 */
const flow = (lines: string[]) =>
  hub === 'eveil-a-soi' && lines.length === 7
    ? [lines[0], lines.slice(1, 3).join(' '), lines[3], lines.slice(4).join(' ')]
    : lines;

// Vidéos de présentation de la page Éveil à Soi (identiques au site actuel)
const videos = hub === 'eveil-a-soi'
  ? [
      { id: 'AvtWBNRF8vE', title: "La transition planétaire terrestre à l'ère du Verseau", meta: 'Juin 2017' },
      { id: 'rALVl8lKlBs', title: "Le défi de l'humanité actuelle", meta: 'Juin 2017' },
    ]
  : [];
---
<Base title={data.metaTitle.replace(' — ', ' · ')} description={data.metaDesc} path={HUBS[hub].path} image={share}>
  <section class="page-hero sky" aria-labelledby="titre">
    {classic
      ? <Fleur class="fleur fleur--right" stroke="rgba(233,204,138,.16)" width={0.45} />
      : <>
          {heroBg && <img class="bg" src={u(heroBg.src)} alt="" style={`object-position:${heroBg.pos}`} fetchpriority="high" />}
          {heroBg && <div class="veil" style="background: linear-gradient(90deg, rgba(7,6,24,.92) 0%, rgba(7,6,24,.6) 45%, rgba(7,6,24,.1) 78%), linear-gradient(180deg, rgba(7,6,24,.7) 0%, rgba(7,6,24,0) 25%, rgba(7,6,24,0) 70%, var(--night) 100%)"></div>}
          <img class="hub-spiral" src={u('/images/geometrie/spirale-fibonacci.svg')} alt="" aria-hidden="true" />
        </>}
    <div class="wrap">
      <nav class="crumbs" aria-label="Fil d'Ariane"><a href={u('/')}>Accueil</a><span aria-hidden="true">/</span><span aria-current="page">{HUBS[hub].label}</span></nav>
      <div style="max-width: 680px">
        <p class="eyebrow" style="margin-top: 44px">{data.eyebrow}</p>
        <h1 id="titre">{data.h1}</h1>
        <p class="lede-serif">{data.lede}</p>
      </div>
    </div>
  </section>

  {classic && (
    <section class="sky" style="padding-bottom: 10px">
      <div class="wrap"><figure class="framed"><img src={u('/images/wp/bandeau-eveil-au-soi-2.jpg')} alt="" loading="lazy" /></figure></div>
    </section>
  )}

  {data.intro.length > 0 && classic && (
    <section class="section sky">
      <div class="wrap"><div class="intro-lines">{data.intro.map((p) => <p set:html={p} />)}</div></div>
    </section>
  )}

  {data.intro.length > 0 && !classic && (
    <section class="section sky">
      <div class="wrap">
        {/* Tout le texte, sans « Lire la suite » à cliquer (retours du 22/10), et plus
            ramassé : les phrases courtes se suivent au lieu d'aller chacune à la ligne. */}
        <div class="intro-lines intro-lines--flow">
          {flow(data.intro).map((p, i) => <p class:list={[{ hl: hub === 'eveil-a-soi' && i === 0 }]} set:html={p} />)}
        </div>
      </div>
    </section>
  )}

  {videos.length > 0 && (
    <section class="section--tight sky">
      <div class="wrap"><div class="video-grid" style="margin-top: 0">{videos.map((v) => <VideoCard {...v} />)}</div></div>
    </section>
  )}

  <section class="section deep">
    <div class="wrap">
      <p class="eyebrow">{hub === 'eveil-a-soi' ? 'Consultations et ateliers' : 'Rubriques et stages'}</p>
      <h2 class="h2" style="margin-top: 14px">{hub === 'eveil-a-soi' ? 'Par où commencer' : 'Explorer'}</h2>
      <div class:list={['cards', { 'cards--2': regular % 3 !== 0 && regular % 2 === 0 }]}>
        {cards.map((c, i) => <Card entry={c} feature={feature(i)} count={stagesOf(c, fiches).length || undefined} />)}
      </div>
    </div>
  </section>

  {entries.length > 0 && !classic && (
    <section class="section sky">
      <div class="wrap">
        <div class="head-row">
          <div><p class="eyebrow">Agenda</p><h2 class="h2" style="margin-top: 14px">Prochaines dates</h2></div>
          <a class="btn" href={u('/agenda/')}>Tout l'agenda<Icon name="arrow" /></a>
        </div>
        <div><AgendaList entries={entries} limit={6} /></div>
      </div>
    </section>
  )}

  {outro.length > 0 && (
    <section class="section--tight sky">
      <div class="wrap wrap--narrow">
        <figure class="rigueur">
          <blockquote>« {outro[0]} »</blockquote>
          {outro.slice(1).map((o) => <figcaption class="serif italic" style="margin-top: 22px; font-size: 21px; color: var(--mist-2)">{o}</figcaption>)}
        </figure>
      </div>
    </section>
  )}

  <ContactBand />
</Base>
