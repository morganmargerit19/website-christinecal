---
/**
 * Vidéo YouTube en « façade » : vignette + bouton, l'iframe (youtube-nocookie)
 * n'est chargée qu'au clic (vie privée, rapidité). Sans JavaScript, ou sur la
 * copie à partager, le lien ouvre la vidéo sur YouTube.
 * Avec `cover` (jaquette DVD) : jaquette à côté + mention de droits Debowska.
 */
import { isArtifact, u } from '../lib/site';
import Icon from './Icon.astro';
import { localDate, tr } from '../lib/i18n';
interface Props {
  id: string; title?: string; meta?: string; credit?: 'debowska'; cover?: string; coverAlt?: string;
  size?: 'normal' | 'large';
  /** À côté de la vidéo voisine (même sujet), au lieu de toute la largeur. */
  half?: boolean;
}
const { id, title, meta, credit, cover, coverAlt, half = false } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}`;
/** Vidéos dont on affiche d'office d'autres sous-titres. Mont Shasta, avril 2019 : l'anglais, pas le français (retours du 26/10). */
const CAPTIONS: Record<string, string> = { 'ouTq-jp9NgM': 'en' };
/** « Juin 2017 · 10 min 42 », « Conférence — 29 novembre 2021 » dans la langue de la page. */
const localMeta = (m: string) => localDate(m.replace(/^Conférence\b/, tr('Conférence')).replace(/^Interview\b/, tr('Interview')).replace(/^Radio\b/, tr('Radio')));
---
<figure class:list={['video', { 'video--dvd': cover, 'video--half': half }]}>
  <div class={cover ? 'frame-row' : undefined}>
    <a class="frame" href={watch} data-yt={isArtifact ? undefined : id} data-cc={CAPTIONS[id]} target="_blank" rel="noopener" aria-label={title ? tr('Voir la vidéo « {t} »', { t: title }) : tr('Voir la vidéo')}>
      <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" onerror="this.remove()" />
      <span class="play" aria-hidden="true"><Icon name="play" /></span>
    </a>
    {cover && (
      <figure class="sleeve"><img src={u(cover)} alt={coverAlt || (title ? tr('Jaquette du DVD « {t} »', { t: title }) : tr('Jaquette du DVD'))} loading="lazy" /></figure>
    )}
  </div>
  {(title || meta || credit) && (
    <figcaption>
      {title && <span class="vt">{title}</span>}
      {meta && <span class="label">{localMeta(meta)}</span>}
      {credit === 'debowska' && (
        <span class="credit">{tr('DVD DEBOWSKA avec Autorisation exceptionnelle de diffusion de Konstanty UDALA DEBOWSKA en hommage pour son épouse Malgorzata Debowska.')} <a href="https://www.debowska.fr/" target="_blank" rel="noopener">{tr('Visiter son site')}</a></span>
      )}
    </figcaption>
  )}
</figure>
