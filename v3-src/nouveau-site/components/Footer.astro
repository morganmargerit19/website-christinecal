---
import { u } from '../lib/site';
import { tr } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';
---
<footer class="site-footer">
  <div class="wrap">
    <span>© {new Date().getFullYear()} Christine CAL · {tr('Tous droits réservés')}</span>
    <nav aria-label={tr('Plan du site')}>
      <a href={u('/mission/')}>{tr('Ma mission')}</a>
      <a href={u('/agenda/')}>{tr('Agenda')}</a>
      <a href={u('/videos/')}>{tr('Vidéos')}</a>
    </nav>
    <nav aria-label={tr('Informations légales')}>
      <a href={u('/mentions-legales/')}>{tr('Mentions légales')}</a>
      <a href={u('/politique-de-confidentialite/')}>{tr('Politique de confidentialité')}</a>
      <a href={u('/cookies/')}>{tr('Cookies')}</a>
    </nav>
    <LangSwitch variant="list" />
    <p class="credit">{tr('Site conçu et réalisé par')} <a href="https://studio-margerit.fr" target="_blank" rel="noopener">Studio Margerit</a></p>
  </div>
</footer>
