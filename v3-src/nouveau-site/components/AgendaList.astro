---
/**
 * Liste chronologique des prochaines dates. Les dates déjà passées au moment
 * du build sont exclues ; un petit script masque aussi, chez le visiteur,
 * celles qui passent entre deux mises à jour du site.
 */
import type { AgendaEntry } from '../lib/agenda';
import { mailto } from '../lib/site';
import Icon from './Icon.astro';
import { tr } from '../lib/i18n';
interface Props { entries: AgendaEntry[]; limit?: number; spare?: number }
const { entries, limit, spare = 4 } = Astro.props;
// On rend quelques entrées de plus que la limite : si une date passe, la suivante prend sa place.
/** S'inscrire : auprès de l'organisateur quand la fiche en donne un (e-mail ou lien), sinon auprès de Christine. */
const bookHref = (e: AgendaEntry) => {
  const i = e.inscription?.trim();
  if (!i) return mailto(e.subject);
  if (/^[^\s@]+@[^\s@]+$/.test(i)) return `mailto:${i}?subject=${encodeURIComponent(e.subject)}`;
  return /^https?:\/\//.test(i) ? i : 'https://' + i;
};
const shown = limit ? entries.slice(0, limit + spare) : entries;
---
<ol class="agenda" data-agenda data-limit={limit}>
  {shown.map((e, i) => (
    <li data-end={e.end} hidden={limit !== undefined && i >= limit}>
      <span class="date">{e.label}</span>
      <span>
        <a class="title" href={e.href}>{e.title}</a>
        {e.rubrique && <span class="rub">{e.rubrique}</span>}
      </span>
      <span class="info">{e.modalites ?? e.info}</span>
      <a class="book" href={bookHref(e)} target={e.inscription && !e.inscription.includes('@') ? '_blank' : undefined} rel={e.inscription && !e.inscription.includes('@') ? 'noopener' : undefined} aria-label={`${tr("S'inscrire")} : ${e.title}, ${e.label}`}>{tr("S'inscrire")}<Icon name="arrow" /></a>
    </li>
  ))}
</ol>
<p class="agenda-empty" data-agenda-empty hidden={shown.length > 0}>{tr('Les prochaines dates arrivent bientôt. Écrivez-moi pour être prévenu(e).')}</p>
