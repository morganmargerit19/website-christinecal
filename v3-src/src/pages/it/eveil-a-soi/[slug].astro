---
import Fiche from '../../../layouts/Fiche.astro';
import { getFiches, slugOf } from '../../../lib/fiches';

export async function getStaticPaths() {
  const fiches = (await getFiches('it')).filter((e) => e.data.hub === 'eveil-a-soi');
  return fiches.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
---
<Fiche entry={entry} locale="it" />
